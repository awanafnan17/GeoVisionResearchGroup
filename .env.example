# ============================================================
# Geo Vision Research Group & GeoSentry - Environment Template
# ============================================================
# Copy this file to .env.local for local development, or configure
# these variables in Netlify Environment Variables for production.
# NEVER commit real secrets or production passwords to Git.

# 1. PostgreSQL Database (Neon Serverless PostgreSQL Free Tier recommended)
# Pooled connection string (-pooler host) used by runtime serverless functions:
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Direct connection string (non-pooler host) used by `npx prisma migrate deploy`:
DIRECT_URL="postgresql://USER:PASSWORD@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. NextAuth / Auth.js v5 Configuration
# Generate a 32-byte secret via: openssl rand -base64 32
AUTH_SECRET="replace-with-32-byte-base64-secret-generated-via-openssl"
NEXTAUTH_SECRET="replace-with-32-byte-base64-secret-generated-via-openssl"
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="http://localhost:3000"

# 3. Public Application Metadata
# On Netlify, URL / DEPLOY_PRIME_URL are detected automatically if omitted.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Geo Vision Research Group"
NEXT_PUBLIC_APP_TAGLINE="International Geoscience Consultancy & Training"
NEXT_PUBLIC_GEOSENTRY_NAME="GeoSentry"
NEXT_PUBLIC_GEOSENTRY_TAGLINE="Geological Intelligence | Risk-Based Screening"

# 4. Outbound Email & Notification Addresses (Optional Resend Integration)
RESEND_API_KEY=""
FROM_EMAIL="no-reply@example.com"
GEOSENTRY_EMAIL="screening@example.com"

# 5. Cloud Production Seed Credentials (Used ONLY when running `npx prisma db seed` against Neon)
# Must be distinct strong passwords (>= 12 chars); predictable demo passwords are automatically rejected.
INITIAL_SUPERADMIN_PASSWORD=""
INITIAL_ADMIN_PASSWORD=""
INITIAL_GEOSENTRY_PASSWORD=""
INITIAL_EXPERT_PASSWORD=""
INITIAL_STUDENT_PASSWORD=""
